{
  "name": "gpt5-server",
  "version": "0.2.0",
  "description": "MCP server for Codex dispatch and durable managed team employees",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "gpt5-server": "build/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/driver.cjs','build/driver.cjs');require('fs').chmodSync('build/index.js','755')\"",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "test": "tsc && node --test build/__tests__/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.5.4"
  }
}
